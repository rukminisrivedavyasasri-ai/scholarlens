{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScholarLensGroundTruthAnnotation",
  "type": "object",
  "required": [
    "document_id",
    "title",
    "authors",
    "year",
    "extracted_fields",
    "ground_truth_qa_pairs"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "authors": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "doi": {
      "type": "string"
    },
    "pdf_filename": {
      "type": "string"
    },
    "extracted_fields": {
      "type": "object",
      "required": ["objective", "methodology", "population", "findings", "limitations"],
      "properties": {
        "objective": { "$ref": "#/$defs/extracted_field" },
        "methodology": { "$ref": "#/$defs/extracted_field" },
        "population": { "$ref": "#/$defs/extracted_field" },
        "findings": { "$ref": "#/$defs/extracted_field" },
        "limitations": { "$ref": "#/$defs/extracted_field" }
      }
    },
    "ground_truth_qa_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "question", "is_unanswerable", "expected_claims"],
        "properties": {
          "question_id": { "type": "string" },
          "question": { "type": "string" },
          "is_unanswerable": { "type": "boolean" },
          "abstention_expected": { "type": "boolean" },
          "expected_answer_summary": { "type": "string" },
          "expected_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim_text", "expected_verification_status", "gold_citations"],
              "properties": {
                "claim_text": { "type": "string" },
                "expected_verification_status": {
                  "type": "string",
                  "enum": ["supported", "partially_supported", "unsupported"]
                },
                "gold_citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["page_number", "verbatim_excerpt"],
                    "properties": {
                      "page_number": { "type": "integer" },
                      "verbatim_excerpt": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "extracted_field": {
      "type": "object",
      "required": ["gold_text", "is_unavailable"],
      "properties": {
        "gold_text": { "type": "string" },
        "is_unavailable": { "type": "boolean" },
        "unavailable_reason": { "type": "string" },
        "page_number": { "type": "integer" },
        "gold_excerpt": { "type": "string" }
      }
    }
  }
}
