# Environment configuration for ScholarLens (Research Reading & Evidence Workspace)

# Database Settings
# Local development default: SQLite
DATABASE_URL=sqlite+aiosqlite:///./scholarlens.db
# Production / Docker Compose default: PostgreSQL + pgvector
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/scholarlens

# Security & Authentication
JWT_SECRET=scholarlens_dev_secret_key_please_change_in_production_92817
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload & Ingestion Constraints
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=application/pdf

# LLM & Embedding Providers (Provider-Agnostic)
EMBEDDING_PROVIDER=local  # options: local, openai, gemini
LLM_PROVIDER=mock         # options: mock, openai, gemini, anthropic, ollama
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Client URL (for CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
